prefix=/mnt/d/code/pxsb_backend/source/build/linux-x86/third_party/install
exec_prefix=/mnt/d/code/pxsb_backend/source/build/linux-x86/third_party/install
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: jsoncpp
Description: A C++ library for interacting with JSON
Version: 1.9.5
URL: https://github.com/open-source-parsers/jsoncpp
Libs: -L${libdir} -ljsoncpp
Cflags: -I${includedir}
